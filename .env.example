# Copiar este archivo como ".env" (mismo directorio que docker-compose.yml)
# y completar con valores propios. El archivo ".env" real NUNCA debe
# subirse a un repositorio (ver .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=adr_tp
POSTGRES_USER=adr_user
POSTGRES_PASSWORD=cambiar_esta_password_segura

# --- Backend ---
NODE_ENV=production
PORT=4000
DB_CONNECT_TIMEOUT_MS=3000

# --- Proxy / puerto expuesto al host ---
# Puerto en el que se accede a la aplicacion desde el navegador:
# http://localhost:PROXY_PORT
PROXY_PORT=8080
