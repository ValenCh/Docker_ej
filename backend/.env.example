# Copiar este archivo como .env (a nivel raiz del proyecto, junto a docker-compose.yml)
# y completar valores reales. El archivo .env NUNCA debe subirse a un repositorio.

# --- PostgreSQL ---
POSTGRES_DB=adr_tp
POSTGRES_USER=adr_user
POSTGRES_PASSWORD=cambiar_esta_password_segura

# --- Backend ---
PORT=4000
NODE_ENV=production
# Nombre del servicio de base de datos dentro de la red de docker compose
PGHOST=db
PGPORT=5432
# Tiempo maximo (ms) para intentar conectar antes de responder 503
DB_CONNECT_TIMEOUT_MS=3000
